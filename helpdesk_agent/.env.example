# Copy this file to .env in this same folder, then fill in your key:
#   cp helpdesk_agent/.env.example helpdesk_agent/.env
#
# agent.py loads this folder's .env first, then falls back to the repository
# root .env, so either location works. A key exported in your shell wins over
# both.

# --- Google AI Studio (simplest) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key

# --- Vertex AI (use instead of GOOGLE_API_KEY) ---
# Run `gcloud auth application-default login` first.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model used by this agent. Optional; defaults to gemini-3.1-flash-lite.
GOOGLE_GENAI_MODEL=gemini-3.1-flash-lite
