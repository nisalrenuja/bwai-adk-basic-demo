# Credentials and local configuration
# These match at any depth, so per-agent files like
# trip_organizer_agent/.env are ignored too.
.env
.env.*
!.env.example
*.key
*-service-account.json
application_default_credentials.json

# Virtual environments
.venv/
.venv*/
venv/
env/

# Python-generated files
__pycache__/
*.py[cod]
*$py.class

# Test, lint, type-check, and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build output
build/
dist/
*.egg-info/

# Google ADK local state
.adk/
sessions.db
*.db
*.db-shm
*.db-wal
*.log

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
