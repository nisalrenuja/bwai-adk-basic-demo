# Copy this file to .env and choose one authentication method.
# One .env at the repository root serves both helpdesk_agent and trip_organizer_agent.

# Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key

# Vertex AI (use these instead of GOOGLE_API_KEY)
# Run `gcloud auth application-default login` first.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Both agents pin their model in code, not here:
#   helpdesk_agent/agent.py       -> the Agent's model= argument
#   trip_organizer_agent/agent.py -> MODEL_NAME, shared by all six sub-agents
