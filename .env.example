# Copy this file to .env and choose one authentication method.
# One .env at the repository root serves both helpdesk_agent and trip_organizer_agent.

# Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key

# Vertex AI (use these instead of GOOGLE_API_KEY)
# Run `gcloud auth application-default login` first.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model used by both agents. Optional; each falls back to
# gemini-3.1-flash-lite if unset.
GOOGLE_GENAI_MODEL=gemini-3.1-flash-lite
